{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "model": "custom/cl​aude-sonnet-5",
  "providers": {
    "custom": {
      "name": "Custom AI",
      "env": [
        "CUSTOM_AI_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "__AI_BASE_URL__",
        "apiKey": "__AI_API_KEY__"
      },
      "models": {
        "cl​aude-sonnet-5": {
          "name": "Cl​aude Sonnet 5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "cl​aude-opus-5": {
          "name": "Cl​aude Opus 5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "cl​aude-fable-5": {
          "name": "Cl​aude Fable 5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "cl​aude-haiku-4-5-20251001": {
          "name": "Cl​aude Haiku 4.5",
          "limit": {
            "context": 200000,
            "output": 66000
          }
        }
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rmdir *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "del *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "erase *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rd *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "ri *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "Remove-Item *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "unlink *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "shred *",
      "effect": "deny"
    }
  ],
  "mcp": {
    "company-atlassian": {
      "type": "local",
      "command": [
        "mcp-atlassian"
      ],
      "enabled": true,
      "environment": {
        "JIRA_URL": "__JIRA_URL__",
        "JIRA_PERSONAL_TOKEN": "__JIRA_PERSONAL_TOKEN__",
        "CONFLUENCE_URL": "__CONFLUENCE_URL__",
        "CONFLUENCE_PERSONAL_TOKEN": "__CONFLUENCE_PERSONAL_TOKEN__",
        "TOOLSETS": "default"
      }
    },
    "gitnexus": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "__GITNEXUS_PATH__",
        "mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "node",
        "__CONTEXT7_PATH__"
      ],
      "enabled": true,
      "environment": {
        "CONTEXT7_API_KEY": "__CONTEXT7_API_KEY__"
      }
    },
    "cloakbrowser": {
      "type": "local",
      "command": [
        "node",
        "__CLOAKBROWSER_SCRIPT__"
      ],
      "enabled": true
    },
    "memorix": {
      "type": "local",
      "command": [
        "memorix",
        "serve",
        "--mode",
        "lite"
      ],
      "enabled": true
    }
  }
}
