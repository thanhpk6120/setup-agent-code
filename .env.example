# Setup Agent Code — Combined .env.example (root dispatcher)
# Copy thanh .env de dung chung cho install.ps1 root va cac setup con:
#   copy .env.example .env
# KHONG commit file .env chua key that.
# Cac setup con tu doc bien moi truong (process env / file .env cuc bo) — khong sua logic ben trong.

# --- AI Gateway dung chung ---
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=

# --- Atlassian (Jira + Confluence) ---
JIRA_URL=https://jira.cybertech.vn
JIRA_PERSONAL_TOKEN=
CONFLUENCE_URL=https://conf.cybertech.vn
CONFLUENCE_PERSONAL_TOKEN=

# --- Context7 (tuy chon) ---
CONTEXT7_API_KEY=

# --- GitLab (tuy chon, cho MCP glab) ---
GITLAB_HOST=10.30.1.17
GITLAB_TOKEN=

# --- DSH Web Runner (setup-dsh-web) ---
DSH_HOST=127.0.0.1
DSH_PORT=8080
DSH_PUBLIC_URL=http://localhost:8080
DSH_TRUSTED_HOSTS=localhost,127.0.0.1
DSH_TOOLS_MODE=all

# --- Memorix (Memory MCP, dung chung tat ca target) ---
ENABLE_MEMORIX=false

# --- Antigravity CLI (setup-antigravity-cli) ---
AGY_MODEL=custom/claude-sonnet-5
