{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "provider": {
    "custom": {
      "name": "Custom AI",
      "baseURL": "__AI_BASE_URL__",
      "apiKey": "__AI_API_KEY__",
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        },
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        },
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        }
      }
    }
  },
  "permission": {
    "bash": {
      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "erase *": "deny",
      "rd *": "deny",
      "ri *": "deny",
      "Remove-Item *": "deny",
      "unlink *": "deny",
      "shred *": "deny"
    }
  },
  "plugin": [
    "./plugins/no-hard-delete.js"
  ],
  "mcp": {
    "company-atlassian": {
      "type": "local",
      "command": [
        "mcp-atlassian"
      ],
      "enabled": true,
      "environment": {
        "JIRA_URL": "__JIRA_URL__",
        "JIRA_PERSONAL_TOKEN": "__JIRA_PERSONAL_TOKEN__",
        "CONFLUENCE_URL": "__CONFLUENCE_URL__",
        "CONFLUENCE_PERSONAL_TOKEN": "__CONFLUENCE_PERSONAL_TOKEN__",
        "TOOLSETS": "default"
      }
    },
    "gitnexus": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "__GITNEXUS_PATH__",
        "mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "node",
        "__CONTEXT7_PATH__"
      ],
      "enabled": true,
      "environment": {
        "CONTEXT7_API_KEY": "__CONTEXT7_API_KEY__"
      }
    },
    "glab": {
      "type": "local",
      "command": [
        "glab",
        "mcp",
        "serve"
      ],
      "enabled": true
    },
    "cloakbrowser": {
      "type": "local",
      "command": [
        "node",
        "__CLOAKBROWSER_SCRIPT__"
      ],
      "enabled": true
    },
    "memorix": {
      "type": "local",
      "command": [
        "memorix",
        "serve",
        "--mode",
        "lite"
      ],
      "enabled": true
    },
    "agency": {
      "type": "local",
      "command": [
        "__AGENCY_PATH__"
      ],
      "enabled": true,
      "timeout": 10000
    }
  }
}