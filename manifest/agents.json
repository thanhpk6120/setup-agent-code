        ]
      },
      "dir": {
        "win": "%APPDATA%\\Block\\goose\\config",
        "unix": "~/.config/goose"
      },
      "instructionFiles": [
        {
          "dest": "<dir>/.goosehints",
          "content": [
            "common/global-rules.md",
            "common/instructions.md",
            "goose/extra.md"
          ],
          "optionalSections": {
            "memorix": "sections/memorix.md"
          }
        }
      ],
      "forbiddenFiles": [],
      "skillsDir": "<dir>/skills",
      "mcp": {
        "adapter": "goose-yaml",
        "file": "<dir>/config.yaml"
      },
      "configs": [
        {
          "template": "goose/config.yaml",
          "dest": "<dir>/config.yaml",
          "kind": "yaml",
          "mcpMerge": true,
          "preserve": true
        }
      ],
      "hooks": [],
      "verify": {
        "files": [
          "<dir>/.goosehints",
          "<dir>/config.yaml"
        ]
      }
    },
