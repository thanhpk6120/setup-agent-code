          "Cai extension trong VS Code: rooveterinaryinc.roo-cline",
          "hoac tu terminal: code --install-extension rooveterinaryinc.roo-cline"
        ]
      },
      "dir": {
        "win": "%USERPROFILE%\\.roo",
        "unix": "~/.roo"
      },
      "extraDirs": {
        "rooSettings": {
          "win": "%APPDATA%\\Code\\User\\globalStorage\\rooveterinaryinc.roo-cline\\settings",
          "unix": "~/.config/Code/User/globalStorage/rooveterinaryinc.roo-cline/settings",
          "fallback": {
            "win": "%USERPROFILE%\\.roo\\settings",
            "unix": "~/.roo/settings"
          }
        }
      },
      "instructionFiles": [
        {
          "dest": "<dir>/rules/AGENTS.md",
          "content": [
            "common/global-rules.md",
            "common/instructions.md",
            "roo/extra.md"
          ],
          "optionalSections": {
            "memorix": "sections/memorix.md"
          }
        }
      ],
      "forbiddenFiles": [],
      "skillsDir": "<dir>/skills",
      "mcp": {
        "adapter": "json-mcpServers",
        "file": "<rooSettings>/mcp_settings.json"
      },
      "configs": [],
      "hooks": [],
      "verify": {
        "files": [
          "<dir>/rules/AGENTS.md",
          "<rooSettings>/mcp_settings.json"
        ]
      }
    }
  ]
}
