{
  "model": "__AGY_MODEL__",
  "toolPermission": {
    "default": "request-review",
    "allow": [],
    "deny": []
  },
  "artifactReviewPolicy": {
    "mode": "request-review",
    "requireHumanApproval": true
  },
  "sandbox": {
    "enabled": true,
    "mode": "workspace-write",
    "networkDefault": "deny"
  },
  "telemetry": {
    "enabled": true,
    "endpoint": "__AI_BASE_URL__",
    "redactSecrets": true
  },
  "env": {
    "AGY_MODEL": "__AGY_MODEL__",
    "AI_BASE_URL": "__AI_BASE_URL__",
    "AI_API_KEY": "__AI_API_KEY__"
  },
  "mcpServers": {
    "company-atlassian": {
      "command": "mcp-atlassian",
      "args": [],
      "env": {
        "JIRA_URL": "__JIRA_URL__",
        "JIRA_PERSONAL_TOKEN": "__JIRA_PERSONAL_TOKEN__",
        "CONFLUENCE_URL": "__CONFLUENCE_URL__",
        "CONFLUENCE_PERSONAL_TOKEN": "__CONFLUENCE_PERSONAL_TOKEN__",
        "TOOLSETS": "default"
      }
    },
    "gitnexus": {
      "command": "cmd",
      "args": ["/c", "__GITNEXUS_PATH__", "mcp"]
    },
    "context7": {
      "command": "node",
      "args": ["__CONTEXT7_PATH__"],
      "env": {
        "CONTEXT7_API_KEY": "__CONTEXT7_API_KEY__"
      }
    },
    "glab": {
      "command": "glab",
      "args": ["mcp", "serve"]
    },
    "cloakbrowser": {
      "command": "node",
      "args": ["__CLOAKBROWSER_SCRIPT__"]
    },
    "memorix": {
      "command": "memorix",
      "args": ["serve", "--mode", "lite"]
    }
  },
  "hooks": {}
}
